---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, sortNotes } from '../lib/content';
import { withBase } from '../site.config';

const notes = sortNotes(await getCollection('notes', ({ data }) => !data.draft));
---

<BaseLayout>
	<section aria-label="按时间排列的文章">
		<ol class="feed">
			{
				notes.map((note) => (
					<li class="feed-item">
						<div class="feed-item__date">
							<time datetime={note.data.published.toISOString()}>
								{formatDate(note.data.published)}
							</time>
							<span class="feed-item__category">{note.data.category.join(' / ')}</span>
						</div>
						<div>
							<h3>
								<a href={withBase(`/notes/${note.id}/`)}>{note.data.title}</a>
							</h3>
							<p class="feed-item__summary">{note.data.summary}</p>
						</div>
					</li>
				))
			}
		</ol>
	</section>
</BaseLayout>
