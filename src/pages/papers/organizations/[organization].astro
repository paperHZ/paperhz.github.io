---
import { getCollection } from 'astro:content';
import PaperList from '../../../components/PaperList.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import type { Paper } from '../../../lib/papers';
import { getPaperOrganizations, sortPapers } from '../../../lib/papers';

export async function getStaticPaths() {
	const papers = await getCollection('papers', ({ data }) => !data.draft);

	return getPaperOrganizations(papers).map((organization) => ({
		params: { organization: organization.name },
		props: {
			organization: organization.name,
			papers: sortPapers(
				papers.filter((paper) =>
					paper.data.organizations.includes(organization.name),
				),
			),
		},
	}));
}

interface Props {
	organization: string;
	papers: Paper[];
}

const { organization, papers } = Astro.props;
const series = new Map<string, Paper[]>();

for (const paper of papers) {
	const entries = series.get(paper.data.series) ?? [];
	entries.push(paper);
	series.set(paper.data.series, entries);
}
---

<BaseLayout
	title={`${organization} 论文路线`}
	description={`${organization} 发表论文的技术路线与阅读记录`}
>
	<header class="page-intro">
		<p class="eyebrow">Organization · {papers.length} papers</p>
		<h1>{organization}</h1>
		<p>可按时间查看完整信息流，也可按技术模块追踪路线；两种视图均为最新论文优先。</p>
	</header>

	<div class="paper-view-switch" role="tablist" aria-label="论文排列方式">
		<button
			type="button"
			role="tab"
			aria-selected="true"
			aria-controls="paper-view-timeline"
			data-paper-view-trigger="timeline"
		>
			按时间
		</button>
		<button
			type="button"
			role="tab"
			aria-selected="false"
			aria-controls="paper-view-series"
			data-paper-view-trigger="series"
		>
			按技术模块
		</button>
	</div>

	<div id="paper-view-timeline" role="tabpanel" data-paper-view="timeline">
		<section class="paper-section paper-section--first">
			<header class="paper-section__head">
				<h2>论文时间线</h2>
				<span>NEW → OLD</span>
			</header>
			<PaperList papers={papers} />
		</section>
	</div>

	<div id="paper-view-series" role="tabpanel" data-paper-view="series" hidden>
		<nav class="paper-route-nav" aria-label="技术路线">
			<span>路线</span>
			{
				[...series.keys()].map((name, index) => (
					<a href={`#series-${index + 1}`}>{name}</a>
				))
			}
		</nav>

		{
			[...series.entries()].map(([name, entries], index) => (
				<section class="paper-series" id={`series-${index + 1}`}>
					<header class="paper-section__head">
						<h2>{name}</h2>
						<span>{entries.length} 篇 · NEW → OLD</span>
					</header>
					<PaperList papers={entries} />
				</section>
			))
		}
	</div>

	<script>
		const triggers = document.querySelectorAll<HTMLButtonElement>(
			'[data-paper-view-trigger]',
		);
		const panels = document.querySelectorAll<HTMLElement>('[data-paper-view]');

		triggers.forEach((trigger) => {
			trigger.addEventListener('click', () => {
				const selected = trigger.dataset.paperViewTrigger;
				triggers.forEach((item) =>
					item.setAttribute('aria-selected', String(item === trigger)),
				);
				panels.forEach((panel) => {
					panel.hidden = panel.dataset.paperView !== selected;
				});
			});
		});
	</script>
</BaseLayout>
