---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Note } from '../../lib/content';
import { formatDate, getTopics, sortNotes } from '../../lib/content';
import { withBase } from '../../site.config';

export async function getStaticPaths() {
	const notes = await getCollection('notes', ({ data }) => !data.draft);

	return getTopics(notes).map((topic) => ({
		params: { topic: topic.name },
		props: {
			topic: topic.name,
			notes: sortNotes(notes.filter((note) => note.data.topics.includes(topic.name))),
		},
	}));
}

interface Props {
	topic: string;
	notes: Note[];
}

const { topic, notes } = Astro.props;
---

<BaseLayout title={`主题：${topic}`} description={`与“${topic}”有关的学习记录`}>
	<header class="page-intro">
		<p class="eyebrow">Topic · {notes.length} notes</p>
		<h1>{topic}</h1>
		<p>按发表时间从近到远排列。</p>
	</header>

	<ol class="feed">
		{
			notes.map((note) => (
				<li class="feed-item">
					<div class="feed-item__date">
						<time datetime={note.data.published.toISOString()}>
							{formatDate(note.data.published)}
						</time>
						<span class="feed-item__category">{note.data.category.join(' / ')}</span>
					</div>
					<div>
						<h3>
							<a href={withBase(`/notes/${note.id}/`)}>{note.data.title}</a>
						</h3>
						<p class="feed-item__summary">{note.data.summary}</p>
						<div class="feed-item__topics">
							{note.data.topics.map((item) => (
								<a href={withBase(`/topics/${encodeURIComponent(item)}/`)}>{item}</a>
							))}
						</div>
					</div>
				</li>
			))
		}
	</ol>
</BaseLayout>
