---
import type { Note } from '../lib/content';
import { buildCategoryTree } from '../lib/content';
import type { Paper } from '../lib/papers';
import { knowledgeTaxonomy, siteConfig, withBase } from '../site.config';
import ArticleToc from './ArticleToc.astro';
import CategoryTree from './CategoryTree.astro';
import PaperTree from './PaperTree.astro';

interface ArticleHeading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	notes: Note[];
	papers: Paper[];
	activeId?: string;
	pathname: string;
	articleHeadings?: ArticleHeading[];
	articleBackHref?: string;
}

const {
	notes,
	papers,
	activeId,
	pathname,
	articleHeadings = [],
	articleBackHref = '/',
} = Astro.props;
const hasArticleToc = articleHeadings.some((heading) => heading.depth === 2);
const knowledgeNotes = notes.filter((note) => !note.data.paperId);
const tree = buildCategoryTree(knowledgeNotes, knowledgeTaxonomy);
const siteTree = tree.filter((node) => node.name === '站点');
const knowledgeTree = tree.filter((node) => node.name !== '站点');
---

<aside class="sidebar" id="site-sidebar" aria-label="文章分类">
	<div class="sidebar__head">
		<a class="brand" href={withBase('/')}>
			<span class="brand__mark">P</span>
			<span>
				<strong>{siteConfig.title}</strong>
				<small>PERSONAL LEARNING LOG</small>
			</span>
		</a>
		<button class="sidebar__close" type="button" data-sidebar-close aria-label="关闭目录">
			<svg aria-hidden="true" viewBox="0 0 24 24">
				<path d="M6 6 18 18M18 6 6 18" />
			</svg>
		</button>
	</div>

	{
		!hasArticleToc && (
			<label class="tree-search">
				<svg aria-hidden="true" viewBox="0 0 24 24">
					<circle cx="11" cy="11" r="6.5" />
					<path d="m16 16 4 4" />
				</svg>
				<input type="search" placeholder="查找内容…" autocomplete="off" data-tree-search />
				<kbd>/</kbd>
			</label>
		)
	}

	<div class="sidebar__label">
		<span>{hasArticleToc ? '本文目录' : '知识目录'}</span>
		{
			hasArticleToc ? (
				<a
					class="sidebar__back"
					href={withBase(articleBackHref)}
					data-sidebar-history-back
				>
					返回索引
				</a>
			) : (
				<span>{notes.length} 文章 · {papers.length} 论文</span>
			)
		}
	</div>

	<nav class="sidebar__tree">
		{
			hasArticleToc ? (
				<ArticleToc headings={articleHeadings} />
			) : (
				<>
					<CategoryTree nodes={knowledgeTree} activeId={activeId} />
					<PaperTree papers={papers} pathname={pathname} />
					<CategoryTree nodes={siteTree} activeId={activeId} />
					<p class="tree-empty" data-tree-empty hidden>
						没有找到相关文章
					</p>
				</>
			)
		}
	</nav>

	<div class="sidebar__foot">
		<span class="status-dot"></span>
		<span>{hasArticleToc ? '文章阅读' : '持续整理中'}</span>
	</div>
</aside>
<button class="sidebar-backdrop" type="button" data-sidebar-close aria-label="关闭目录"></button>

<script>
	const input = document.querySelector<HTMLInputElement>('[data-tree-search]');
	const notes = [...document.querySelectorAll<HTMLElement>('[data-tree-note]')];
	const groups = [...document.querySelectorAll<HTMLElement>('[data-tree-group]')].reverse();
	const empty = document.querySelector<HTMLElement>('[data-tree-empty]');
	const treeDetails = [
		...document.querySelectorAll<HTMLDetailsElement>('details[data-tree-key]'),
	];
	const treeStorageKey = 'paperHZ:sidebar-tree-state';

	function saveTreeState() {
		if (treeDetails.length === 0) return;
		const state = Object.fromEntries(
			treeDetails.map((details) => [details.dataset.treeKey, details.open]),
		);
		sessionStorage.setItem(treeStorageKey, JSON.stringify(state));
	}

	if (treeDetails.length > 0) {
		try {
			const savedState = JSON.parse(
				sessionStorage.getItem(treeStorageKey) ?? '{}',
			) as Record<string, boolean>;
			treeDetails.forEach((details) => {
				const key = details.dataset.treeKey;
				if (key && key in savedState) details.open = savedState[key];
			});
		} catch {
			sessionStorage.removeItem(treeStorageKey);
		}

		treeDetails.forEach((details) =>
			details.addEventListener('toggle', saveTreeState),
		);
		document
			.querySelectorAll<HTMLAnchorElement>('.sidebar__tree a')
			.forEach((link) => link.addEventListener('click', saveTreeState));
	}

	document
		.querySelector<HTMLAnchorElement>('[data-sidebar-history-back]')
		?.addEventListener('click', (event) => {
			if (!document.referrer) return;
			const referrer = new URL(document.referrer);
			if (referrer.origin !== window.location.origin) return;
			event.preventDefault();
			window.location.assign(referrer.href);
		});

	function filterTree(query: string) {
		const normalized = query.trim().toLocaleLowerCase('zh-CN');
		let visibleCount = 0;

		for (const note of notes) {
			const isVisible = !normalized || note.dataset.search?.includes(normalized);
			note.hidden = !isVisible;
			if (isVisible) visibleCount += 1;
		}

		for (const group of groups) {
			const matchesCategory = Boolean(
				normalized && group.dataset.search?.includes(normalized),
			);
			const hasVisibleNote = Boolean(group.querySelector('[data-tree-note]:not([hidden])'));
			const hasVisibleGroup = Boolean(group.querySelector('[data-tree-group]:not([hidden])'));
			const isVisible =
				!normalized || matchesCategory || hasVisibleNote || hasVisibleGroup;
			group.hidden = !isVisible;
			if (normalized && isVisible) group.querySelector('details')?.setAttribute('open', '');
		}

		const visibleGroupCount = groups.filter((group) => !group.hidden).length;
		if (empty) empty.hidden = visibleCount > 0 || visibleGroupCount > 0;
	}

	input?.addEventListener('input', () => filterTree(input.value));

	document.addEventListener('keydown', (event) => {
		const target = event.target as HTMLElement;
		const isTyping = target.matches('input, textarea, [contenteditable="true"]');

		if (event.key === '/' && !isTyping) {
			event.preventDefault();
			input?.focus();
		}

		if (event.key === 'Escape' && input && document.activeElement === input) {
			input.value = '';
			filterTree('');
			input.blur();
		}
	});
</script>
